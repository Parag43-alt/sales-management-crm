<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hosho CRM - Enterprise Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { margin: 0; font-family: 'Poppins', sans-serif; background-color: #0d1117; color: #c9d1d9; display: flex; height: 100vh; overflow: hidden; }
        
        /* Sidebar */
        .sidebar { width: 260px; background-color: #161b22; padding: 25px 20px; border-right: 1px solid #30363d; display: flex; flex-direction: column; z-index: 10; box-shadow: 5px 0 15px rgba(0,0,0,0.2);}
        .sidebar h2 { color: #58a6ff; margin-bottom: 40px; font-weight: 600; text-align: center; letter-spacing: 1px; }
        .nav-link { display: flex; align-items: center; padding: 14px 18px; color: #8b949e; text-decoration: none; margin-bottom: 12px; border-radius: 8px; cursor: pointer; font-weight: 500; transition: all 0.3s; border: 1px solid transparent; }
        .nav-link:hover { background-color: #21262d; color: #e6edf3; transform: translateX(6px); }
        .nav-link.active { background: linear-gradient(90deg, #1f6feb 0%, #388bfd 100%); color: #ffffff; box-shadow: 0 4px 15px rgba(31, 111, 235, 0.4); }

        /* Main Content */
        .main-content { flex: 1; padding: 30px 45px; overflow-y: auto; background: radial-gradient(circle at top left, #121820 0%, #0d1117 100%); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid rgba(48, 54, 61, 0.6); padding-bottom: 20px; }
        .header h1 { margin: 0; font-size: 24px; color: #ffffff; font-weight: 600; }
        .btn-primary { background: linear-gradient(90deg, #238636, #2ea043); color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: 600; box-shadow: 0 4px 12px rgba(46, 160, 67, 0.3); transition: 0.2s; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(46, 160, 67, 0.5); }
        .btn-logout { background: transparent; color: #f85149; border: 1px solid #f85149; padding: 8px 18px; border-radius: 6px; cursor: pointer; transition: 0.3s; }
        .btn-logout:hover { background: #f85149; color: white; }

        /* Analytics Grid */
        .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
        .kpi-card { background: #161b22; padding: 20px; border-radius: 10px; border: 1px solid #30363d; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .kpi-card h3 { margin: 0 0 10px 0; color: #8b949e; font-size: 13px; text-transform: uppercase; }
        .kpi-card p { margin: 0; font-size: 26px; font-weight: 600; color: #ffffff; }
        .charts-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 30px; }
        .chart-container { background: #161b22; padding: 20px; border-radius: 10px; border: 1px solid #30363d; height: 300px; }

        /* Modern Tables & Controls */
        .toolbar { display: flex; justify-content: space-between; margin-bottom: 20px; }
        .search-box { padding: 10px 15px; width: 300px; border-radius: 6px; border: 1px solid #30363d; background: #0d1117; color: white; outline: none; transition: 0.3s; }
        .search-box:focus { border-color: #58a6ff; }
        
        .table-wrapper { background-color: #161b22; border-radius: 10px; border: 1px solid #30363d; overflow: hidden; }
        .crm-table { width: 100%; border-collapse: collapse; text-align: left; }
        .crm-table th { padding: 15px; background: #0d1117; color: #8b949e; font-size: 13px; text-transform: uppercase; border-bottom: 1px solid #30363d; }
        .crm-table td { padding: 15px; border-bottom: 1px solid rgba(48, 54, 61, 0.5); color: #c9d1d9; font-size: 14px; }
        .crm-table tr:hover { background-color: rgba(255, 255, 255, 0.02); }

        /* Interactive Elements */
        .status-badge { padding: 5px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; color: white; }
        .progress-track { width: 100%; background: #30363d; border-radius: 10px; height: 6px; margin-top: 5px; }
        .progress-fill { height: 100%; border-radius: 10px; background: linear-gradient(90deg, #1f6feb, #58a6ff); }
        
        .action-icon { background: #21262d; border: 1px solid #30363d; color: #8b949e; padding: 6px 10px; border-radius: 4px; cursor: pointer; transition: 0.2s; margin-right: 5px; font-size: 12px; }
        .action-icon:hover { color: #ffffff; border-color: #8b949e; }
        .ai-btn { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid #10b981; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; transition: 0.3s; }
        .ai-btn:hover { background: #10b981; color: white; }

        /* Toast Notifications */
        #toast-container { position: fixed; bottom: 30px; right: 30px; z-index: 9999; }
        .toast { background: #1f6feb; color: white; padding: 12px 24px; border-radius: 6px; margin-top: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); display: flex; align-items: center; gap: 10px; opacity: 0; transform: translateX(100%); transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55); }
        .toast.show { opacity: 1; transform: translateX(0); }
    </style>
</head>
<body>

    <div class="sidebar">
        <h2>Hosho CRM</h2>
        <a class="nav-link active" onclick="changeSection('dashboard', this)">📊 Dashboard</a>
        <a class="nav-link" onclick="changeSection('customers', this)">👥 Accounts</a>
        <a class="nav-link" onclick="changeSection('opportunities', this)">💼 Pipeline</a>
        <a class="nav-link" onclick="changeSection('activities', this)">📅 Activities</a>
    </div>

    <div class="main-content">
        <div class="header">
            <h1 id="page-title">Business Overview</h1>
            <button class="btn-logout" onclick="logout()">Sign Out</button>
        </div>
        <div id="dynamic-content">
            </div>
    </div>

    <div id="toast-container"></div>

    <script>
        // Check Authentication
        if (!localStorage.getItem("token")) window.location.href = "/login";
        function logout() { localStorage.removeItem("token"); window.location.href = "/login"; }

        // --- 1. ENTERPRISE TOAST NOTIFICATION SYSTEM ---
        function showToast(message, type = "success") {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.style.background = type === 'success' ? 'linear-gradient(90deg, #238636, #2ea043)' : 'linear-gradient(90deg, #da3633, #f85149)';
            toast.innerHTML = `<strong>${type === 'success' ? '✓' : '⚠'}</strong> ${message}`;
            container.appendChild(toast);
            
            setTimeout(() => toast.classList.add('show'), 10);
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Action Simulator for realistic interaction
        function simulateAction(actionName) { showToast(`${actionName} action triggered successfully.`, "success"); }

        // --- 2. BULLETPROOF AI AGENT ---
        async function draftAIEmail(customerName, status, btnElement) {
            const originalText = btnElement.innerText;
            btnElement.innerText = "⏳ Generating...";
            btnElement.disabled = true;

            const fallbackText = `Hi ${customerName} Team,\n\nFollowing up on our recent discussions. As your account is currently marked as '${status}', please let me know if you need anything from our side to proceed.\n\nBest,\nHosho Sales`;
            try {
                const response = await fetch('/api/v1/ai/draft-email', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: customerName, status: status })
                });
                if (response.ok) {
                    const data = await response.json();
                    alert(`✨ AI DRAFT FOR ${customerName}:\n\n${(data && data.email && data.email !== "undefined") ? data.email : fallbackText}`);
                    showToast("AI Email Generated", "success");
                } else { throw new Error("API Down"); }
            } catch (error) {
                alert(`✨ AI DRAFT FOR ${customerName}:\n\n${fallbackText}`);
                showToast("Fallback AI Template Used", "success");
            }
            btnElement.innerText = originalText;
            btnElement.disabled = false;
        }

        // --- 3. LIVE SEARCH FILTER ---
        function filterTable() {
            const input = document.getElementById("searchInput").value.toLowerCase();
            const rows = document.querySelectorAll(".crm-table tr.data-row");
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? "" : "none";
            });
        }

        // --- 4. REALISTIC DASHBOARD VIEW (CHARTS) ---
        function loadDashboardView() {
            document.getElementById('dynamic-content').innerHTML = `
                <div class="kpi-grid">
                    <div class="kpi-card"><h3>Total Revenue</h3><p>$124,500</p></div>
                    <div class="kpi-card"><h3>Active Accounts</h3><p>42</p></div>
                    <div class="kpi-card"><h3>Win Rate</h3><p>68%</p></div>
                    <div class="kpi-card"><h3>Pending Tasks</h3><p>12</p></div>
                </div>
                <div class="charts-grid">
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                    <div class="chart-container">
                        <canvas id="pipelineChart"></canvas>
                    </div>
                </div>
            `;

            // Render Chart.js
            setTimeout(() => {
                const ctx1 = document.getElementById('revenueChart').getContext('2d');
                new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                        datasets: [{
                            label: 'Monthly Revenue ($)',
                            data: [30000, 45000, 42000, 60000, 85000, 124500],
                            borderColor: '#58a6ff', backgroundColor: 'rgba(88, 166, 255, 0.1)',
                            borderWidth: 2, fill: true, tension: 0.4
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#8b949e' } } }, scales: { x: { ticks: { color: '#8b949e' }, grid: { color: '#30363d' } }, y: { ticks: { color: '#8b949e' }, grid: { color: '#30363d' } } } }
                });

                const ctx2 = document.getElementById('pipelineChart').getContext('2d');
                new Chart(ctx2, {
                    type: 'doughnut',
                    data: {
                        labels: ['Discovery', 'Proposal', 'Negotiation', 'Closed'],
                        datasets: [{ data: [15, 10, 5, 12], backgroundColor: ['#8957e5', '#d29922', '#e34c26', '#238636'], borderWidth: 0 }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { color: '#8b949e' } } } }
                });
            }, 100);
        }

        // --- 5. DYNAMIC DATA FETCHER & RENDERER ---
        async function fetchAndRender(url, type) {
            const dynamicContent = document.getElementById('dynamic-content');
            dynamicContent.innerHTML = `<div style="text-align: center; margin-top: 50px;"><p style="color: #58a6ff;">Syncing with Data Center...</p></div>`;
            
            try {
                const response = await fetch(url, { headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') } });
                if (response.ok) {
                    const data = await response.json();
                    
                    // Toolbar for real-world usability
                    let html = `
                        <div class="toolbar">
                            <input type="text" id="searchInput" class="search-box" placeholder="Search ${type}..." onkeyup="filterTable()">
                            <button class="btn-primary" onclick="simulateAction('Add New ${type}')">+ Create New</button>
                        </div>
                        <div class="table-wrapper"><table class="crm-table">
                    `;
                    
                    if (type === 'customers') {
                        html += `<tr><th>ID</th><th>Account Name</th><th>Contact Details</th><th>Health Score</th><th>Actions</th></tr>`;
                        data.forEach(c => html += `<tr class="data-row"><td style="color: #8b949e;">#${c.id}</td><td style="font-weight: 600;">${c.name}</td><td>${c.email}</td><td><span class="status-badge" style="background: ${c.status === 'Active' ? '#238636' : '#d29922'};">${c.status}</span></td><td><button class="action-icon" onclick="simulateAction('View Profile')">👁</button><button class="ai-btn" onclick="draftAIEmail('${c.name}', '${c.status}', this)">✨ AI Draft</button></td></tr>`);
                    } else if (type === 'opportunities') {
                        html += `<tr><th>ID</th><th>Client</th><th>Expected Value</th><th>Pipeline Stage</th><th>Actions</th></tr>`;
                        data.forEach(o => {
                            // Calculate realistic progress bar based on stage
                            let prog = 20; let color = '#8957e5';
                            if(o.stage.includes('Proposal')) { prog = 50; color = '#d29922'; }
                            if(o.stage.includes('Negotiation')) { prog = 80; color = '#e34c26'; }
                            if(o.stage.includes('Closed') || o.stage.includes('Won')) { prog = 100; color = '#238636'; }
                            
                            html += `<tr class="data-row"><td style="color: #8b949e;">#${o.id}</td><td style="font-weight: 600;">${o.customer}</td><td style="color: #3fb950; font-weight: 600;">${o.amount}</td><td><span style="font-size:12px; color:#c9d1d9;">${o.stage}</span><div class="progress-track"><div class="progress-fill" style="width: ${prog}%; background: ${color};"></div></div></td><td><button class="action-icon" onclick="simulateAction('Edit Deal')">✎</button></td></tr>`;
                        });
                    } else if (type === 'activities') {
                        html += `<tr><th>ID</th><th>Priority</th><th>Activity Log</th><th>Scheduled Date</th><th>Actions</th></tr>`;
                        data.forEach(a => {
                            // Assign realistic priorities based on keywords
                            let pBadge = `<span class="status-badge" style="background: #1f6feb;">Medium</span>`;
                            if(a.type === 'Meeting' || a.description.includes('pricing')) pBadge = `<span class="status-badge" style="background: #da3633;">High</span>`;
                            
                            html += `<tr class="data-row"><td style="color: #8b949e;">#${a.id}</td><td>${pBadge} <span style="font-size:12px; color:#8b949e;">(${a.type})</span></td><td>${a.description}</td><td style="color: #8b949e;">${a.date}</td><td><button class="action-icon" onclick="simulateAction('Mark Complete')">✓</button></td></tr>`;
                        });
                    }
                    html += `</table></div>`;
                    dynamicContent.innerHTML = html;
                }
            } catch (error) { showToast("Network Error", "error"); }
        }

        // --- 6. NAVIGATION HANDLER ---
        function changeSection(sectionName, element) {
            document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));
            element.classList.add('active');
            
            const titles = { 'dashboard': 'Business Overview', 'customers': 'Account Management', 'opportunities': 'Sales Pipeline', 'activities': 'Activity Tracker' };
            document.getElementById('page-title').innerText = titles[sectionName];

            if (sectionName === 'dashboard') loadDashboardView(); 
            else fetchAndRender(`/api/v1/${sectionName}`, sectionName);
        }

        // Init App
        window.onload = loadDashboardView;
    </script>
</body>
</html>
